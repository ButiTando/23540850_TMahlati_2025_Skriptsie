{
    "version": 4,
    "configurations": [
        {
            "name": "STM32F767 (arm-none-eabi)",
            // compileCommands is authoritative: CMake regenerates it on every
            // configure, so new files and new -I flags are picked up with no
            // edit here. includePath is only the fallback for files not yet
            // in that database.
            "compileCommands": "${workspaceFolder}/build/Debug/compile_commands.json",
            "includePath": [
                // Fallback only. compileCommands above provides the exact -I
                // flags for every file CMake builds; this catches anything not
                // yet in that database (a new .cpp before the next configure).
                "${workspaceFolder}/**"
            ],
            "browse": {
                // Drivers/CMSIS/DSP and NN hold ~690 files this firmware never
                // builds; excluding them keeps the symbol database fast.
                "path": [
                    "${workspaceFolder}/Core",
                    "${workspaceFolder}/ILT_OS",
                    "${workspaceFolder}/LWIP",
                    "${workspaceFolder}/Drivers/STM32F7xx_HAL_Driver",
                    "${workspaceFolder}/Drivers/BSP",
                    "${workspaceFolder}/Drivers/CMSIS/Include",
                    "${workspaceFolder}/Drivers/CMSIS/Device",
                    "${workspaceFolder}/Middlewares"
                ],
                "limitSymbolsToIncludedHeaders": true
            },
            "defines": [
                "USE_HAL_DRIVER",
                "STM32F767xx"
            ],
            "compilerPath": "/opt/st/stm32cubeclt_1.20.0/GNU-tools-for-STM32/bin/arm-none-eabi-gcc",
            "compilerArgs": [
                "-mcpu=cortex-m7",
                "-mthumb",
                "-mfpu=fpv5-d16",
                "-mfloat-abi=hard"
            ],
            "cStandard": "gnu11",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "linux-gcc-arm"
        }
    ]
}
